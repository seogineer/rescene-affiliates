---
import Base from '../layouts/Base.astro';
import SponsorList from '../components/SponsorList.astro';
import AppearanceList from '../components/AppearanceList.astro';
import { url, newIssueUrl } from '../config';
import { getSponsors } from '../lib/sponsors';
import { getAppearances } from '../lib/appearances';
import { ytThumb, ytWatch } from '../lib/youtube';
import EventRow from '../components/EventRow.astro';
import { splitSchedule, seoulToday } from '../lib/schedule';
import { MEMBERS, MEMBER_SLUG } from '../lib/members';
import { website } from '../lib/seo';
import { HERO } from '../data/official';

const items = await getSponsors();
const appearances = await getAppearances();
const next = splitSchedule(
	appearances.map(({ entry }) => ({ id: entry.id, name: entry.data.name, category: entry.data.category, eventDate: entry.data.eventDate, eventTime: entry.data.eventTime, pending: entry.data.summary.includes('확인필요') })),
	seoulToday(),
).upcoming.slice(0, 3);
const activeCount = items.filter(({ entry }) => entry.data.status === '진행중').length;
---
<Base
	image={ytThumb(HERO.id, 'maxresdefault')}
	fullTitle="리센느(RESCENE) 팬 사이트 · 리마인(REMINE) 위키 - 광고·출연·일정 정리 | 리센느 계열사"
	description="리센느(RESCENE)가 광고·협찬으로 함께한 기업, 출연한 예능·음악방송·라디오·유튜브와 행사 일정을 출처와 함께 정리한 리마인(REMINE) 팬 위키입니다."
	jsonLd={[website(new URL(url(), Astro.site).href)]}
>
	<section class="hero">
		<div class="eyebrow">Re : Scene with RESCENE</div>
		<h1>리센느 <em>계열사</em></h1>
		<p class="lead">리센느(RESCENE)와 함께한 기업과 출연 프로그램, 그리고 공개된 이미지·영상을 리마인(REMINE)이 함께 기록합니다.</p>
		<figure class="hero-photo">
			<img src={ytThumb(HERO.id, 'maxresdefault')} alt="한복을 입은 리센느 멤버 다섯 명" />
			<figcaption>사진 · <a href={ytWatch(HERO.id)} target="_blank" rel="noopener noreferrer">RESCENE 공식 유튜브 「{HERO.title}」</a></figcaption>
		</figure>
		<div class="stats">
			<div class="stat"><b>{items.length}</b><span>함께한 기업</span></div>
			<div class="stat"><b>{activeCount}</b><span>진행 중</span></div>
			<div class="stat"><b>{appearances.length}</b><span>출연</span></div>
		</div>
		<nav class="chips member-nav" aria-label="멤버별 보기"><span class="meta">멤버별 보기</span>{MEMBERS.map((m) => <a class="chip" href={url(`members/${MEMBER_SLUG[m]}/`)}>{m}</a>)}</nav>
		<p class="note">※ '계열사'는 소속사 계열사가 아니라, 리센느와 함께한 기업을 부르는 팬들의 애칭입니다.</p>
	</section>

	{next.length > 0 && (
		<section class="upcoming" aria-labelledby="upcoming-h">
			<div class="sec-line"><h2 id="upcoming-h">다가오는 일정</h2><a href={url('schedule/')}>전체 일정 →</a></div>
			<ul class="events">{next.map((e) => <EventRow {...e} eventDate={e.eventDate!} />)}</ul>
		</section>
	)}

	<!-- 탭은 주소 해시(#sponsors, #appearances)로 고른다. 패널 id는 해시와 달라서 브라우저가 패널로 건너뛰지 않는다. -->
	<div class="tabs" id="tabs" role="tablist" aria-label="목록">
		<a class="tab" role="tab" id="tab-sponsors" href="#sponsors" aria-controls="panel-sponsors" aria-selected="true">기업<b>{items.length}</b></a>
		<a class="tab" role="tab" id="tab-appearances" href="#appearances" aria-controls="panel-appearances" aria-selected="false" tabindex="-1">출연<b>{appearances.length}</b></a>
	</div>
	<section id="panel-sponsors" role="tabpanel" aria-labelledby="tab-sponsors">
		<SponsorList />
	</section>
	<section id="panel-appearances" role="tabpanel" aria-labelledby="tab-appearances" hidden>
		<AppearanceList />
	</section>

	<script>
		import { TABS, tabFromHash } from '../lib/tabs';
		const tabs = document.querySelector<HTMLElement>('#tabs')!;
		function select(scroll: boolean) {
			const active = tabFromHash(location.hash);
			for (const t of TABS) {
				const on = t === active;
				const tab = document.querySelector<HTMLElement>(`#tab-${t}`)!;
				tab.setAttribute('aria-selected', String(on));
				tab.tabIndex = on ? 0 : -1;
				document.querySelector<HTMLElement>(`#panel-${t}`)!.hidden = !on;
			}
			// 헤더 메뉴처럼 다른 곳에서 해시로 들어왔을 때, 탭이 화면 밖이면 탭 위치로 내려간다.
			const top = tabs.getBoundingClientRect().top;
			if (scroll && (top < 0 || top > innerHeight - 80)) tabs.scrollIntoView({ block: 'start', behavior: 'instant' });
		}
		addEventListener('hashchange', () => select(true));
		select(location.hash !== '');
	</script>

	<section class="contribute">
		<div>
			<h2>함께 기록해 주세요</h2>
			<p>잘못된 내용은 각 문서의 ✏️ 편집으로 고치고, 새 기업·출연이나 이미지·영상은 제보해 주세요.</p>
		</div>
		<div class="actions">
			<a class="btn" href={newIssueUrl('new-sponsor.yml')}>기업 제보</a>
			<a class="btn ghost" href={newIssueUrl('new-appearance.yml')}>출연 제보</a>
			<a class="btn ghost" href={newIssueUrl('add-media.yml')}>이미지·영상 제보</a>
		</div>
	</section>
</Base>
