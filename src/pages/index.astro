---
import Base from '../layouts/Base.astro';
import { url, newIssueUrl } from '../config';
import { getSponsors } from '../lib/sponsors';
import { ytThumb, ytWatch } from '../lib/youtube';
import { HERO } from '../data/official';

const items = await getSponsors();
const mediaCount = items.reduce((n, { entry }) => n + entry.data.media.length, 0);
const activeCount = items.filter(({ entry }) => entry.data.status === '진행중').length;
const statuses = ['진행중', '확인필요', '종료'].filter((st) => items.some(({ entry }) => entry.data.status === st));
const types = [...new Set(items.map(({ entry }) => entry.data.type))];
---
<Base image={ytThumb(HERO.id, 'maxresdefault')}>
	<section class="hero">
		<div class="eyebrow">Re : Scene with RESCENE</div>
		<h1>리센느 <em>계열사</em></h1>
		<p class="lead">리센느와 함께한 기업, 그리고 기업이 공개한 이미지·영상을 팬들이 함께 기록합니다.</p>
		<figure class="hero-photo">
			<img src={ytThumb(HERO.id, 'maxresdefault')} alt="한복을 입은 리센느 멤버 다섯 명" />
			<figcaption>사진 · <a href={ytWatch(HERO.id)} target="_blank" rel="noopener noreferrer">RESCENE 공식 유튜브 「{HERO.title}」</a></figcaption>
		</figure>
		<div class="stats">
			<div class="stat"><b>{items.length}</b><span>함께한 기업</span></div>
			<div class="stat"><b>{activeCount}</b><span>진행 중</span></div>
			<div class="stat"><b>{mediaCount}</b><span>이미지·영상</span></div>
		</div>
		<p class="note">※ '계열사'는 소속사 계열사가 아니라, 리센느와 함께한 기업을 부르는 팬들의 애칭입니다.</p>
	</section>

	<div class="sec-head">
		<h2><small>Scenes with brands</small>함께한 기업</h2>
		<p>최근 시작한 순서</p>
	</div>
	<div class="filters" role="search">
		<input id="q" type="search" placeholder="기업 이름·내용 검색" aria-label="기업 검색" />
		<div class="chips" id="status-chips">
			<button type="button" class="chip on" data-status="">전체</button>
			{statuses.map((st) => <button type="button" class="chip" data-status={st}>{st}</button>)}
		</div>
		<select id="type" aria-label="후원 형태">
			<option value="">모든 형태</option>
			{types.map((t) => <option value={t}>{t}</option>)}
		</select>
	</div>
	<p id="empty" class="meta" hidden>조건에 맞는 기업이 없습니다. <a href={newIssueUrl('new-sponsor.yml')}>기업 제보하기</a></p>
	<div class="grid" id="grid">
		{items.map(({ entry: s, scene, cover, tone }) => (
			<article class="card" data-status={s.data.status} data-type={s.data.type} data-text={`${s.data.name} ${s.data.summary}`.toLowerCase()}>
				{cover ? (
					<div class="cover"><img src={ytThumb(cover)} alt="" loading="lazy" /><span class="scene-tag">SCENE {scene}</span></div>
				) : (
					<div class={`cover blank tone-${tone}`}>{s.data.name.slice(0, 1)}<span class="scene-tag">SCENE {scene}</span></div>
				)}
				<div class="card-body">
					<div class="badges">
						<span class={`badge ${s.data.status}`}>{s.data.status}</span>
						<span class="badge">{s.data.type}</span>
						{s.data.sample && <span class="badge sample">샘플</span>}
					</div>
					<h3><a class="stretch" href={url(`sponsors/${s.id}/`)}>{s.data.name}</a></h3>
					<p>{s.data.summary}</p>
					<div class="meta">
						{s.data.startDate && <>{s.data.startDate}~ · </>}
						{s.data.media.length > 0 ? `이미지·영상 ${s.data.media.length}개` : '이미지·영상 준비 중'}
					</div>
				</div>
			</article>
		))}
	</div>

	<script>
		const q = document.querySelector<HTMLInputElement>('#q')!;
		const typeSel = document.querySelector<HTMLSelectElement>('#type')!;
		const chips = [...document.querySelectorAll<HTMLButtonElement>('#status-chips .chip')];
		const cards = [...document.querySelectorAll<HTMLElement>('#grid .card')];
		const empty = document.querySelector<HTMLElement>('#empty')!;
		let status = '';
		function apply() {
			const text = q.value.trim().toLowerCase();
			let shown = 0;
			for (const c of cards) {
				const ok =
					(!status || c.dataset.status === status) &&
					(!typeSel.value || c.dataset.type === typeSel.value) &&
					(!text || c.dataset.text!.includes(text));
				c.hidden = !ok;
				if (ok) shown++;
			}
			empty.hidden = shown > 0;
		}
		q.addEventListener('input', apply);
		typeSel.addEventListener('change', apply);
		for (const b of chips) {
			b.addEventListener('click', () => {
				status = b.dataset.status ?? '';
				chips.forEach((x) => x.classList.toggle('on', x === b));
				apply();
			});
		}
	</script>

	<section class="contribute">
		<div>
			<h2>함께 기록해 주세요</h2>
			<p>잘못된 내용은 각 문서의 ✏️ 편집으로 고치고, 새 기업이나 이미지·영상은 제보해 주세요.</p>
		</div>
		<div class="actions">
			<a class="btn" href={newIssueUrl('new-sponsor.yml')}>기업 제보</a>
			<a class="btn ghost" href={newIssueUrl('add-media.yml')}>이미지·영상 제보</a>
		</div>
	</section>
</Base>
