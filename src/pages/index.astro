---
import Base from '../layouts/Base.astro';
import { url, newIssueUrl } from '../config';
import { getSponsors } from '../lib/sponsors';

const items = await getSponsors();
const mediaCount = items.reduce((n, { entry }) => n + entry.data.media.length, 0);
---
<Base>
	<section class="hero">
		<div class="eyebrow">Re : Scene</div>
		<h1>리센느 계열사</h1>
		<p class="lead">리센느와 함께한 기업과, 기업이 공개한 이미지·영상 링크를 팬들이 함께 채워가는 위키입니다.</p>
		<div class="stats"><span><b>{items.length}</b>기업</span><span><b>{mediaCount}</b>미디어</span></div>
	</section>
	<p class="note">※ 소속사 계열사가 아니라, 리센느와 함께한 기업을 가리키는 팬들의 애칭입니다.</p>
	<div class="notice">
		잘못됐거나 빠진 내용을 발견하셨나요? 각 문서의 <strong>✏️ 이 문서 편집</strong>으로 직접 수정하거나,
		<a href={newIssueUrl('new-sponsor.yml')}>기업 제보</a> · <a href={newIssueUrl('add-media.yml')}>미디어 추가 제보</a>를 남겨주세요.
	</div>
	<div class="grid">
		{items.map(({ entry: s, scene }) => (
			<article class="card link">
				<span class="film-holes" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
				<div class="scene-no">SCENE {scene}</div>
				<h3><a class="stretch" href={url(`sponsors/${s.id}/`)}>{s.data.name}</a></h3>
				<div>
					<span class={`badge ${s.data.status}`}>{s.data.status}</span>
					<span class="badge">{s.data.type}</span>
					{s.data.sample && <span class="badge sample">샘플</span>}
				</div>
				<p>{s.data.summary}</p>
				<div class="meta">{s.data.media.length > 0 ? `🎞 미디어 ${s.data.media.length}건` : '🎞 미디어 준비 중'}</div>
			</article>
		))}
	</div>
</Base>
