---
// 출연 목록은 메인의 출연 탭으로 옮겼다. 예전 주소로 들어오면 그 탭으로 넘긴다.
// GitHub Pages는 서버 리다이렉트가 없어서 meta refresh와 스크립트로 넘기고, 검색엔진 색인에서는 뺀다.
import { url } from '../../config';
const to = url('#appearances');
const canonical = new URL(url(), Astro.site).href;
---
<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={canonical} />
		<meta http-equiv="refresh" content={`0; url=${to}`} />
		<title>출연 · 리센느 계열사</title>
		<script is:inline define:vars={{ to }}>location.replace(to);</script>
	</head>
	<body>
		<p><a href={to}>출연 목록으로 이동</a></p>
	</body>
</html>
