---
import Base from '../layouts/Base.astro';
import { REPO_URL, newIssueUrl } from '../config';
const faqs = [
	['\'계열사\'가 무슨 뜻인가요?', '소속사의 계열사가 아니라, 리센느와 함께한 기업을 부르는 팬들의 애칭입니다. 소속사·기업과 무관한 비공식 팬 사이트예요.'],
	['누구나 고칠 수 있나요?', '네. 각 문서의 ✏️ 이 문서 편집으로 GitHub에서 직접 고치면 검토 후 반영됩니다. GitHub이 낯설다면 제보 양식을 이용하세요.'],
	['출처는 어떻게 적나요?', '기사, 공식 SNS, 방송사·기업 공지처럼 사실을 확인할 수 있는 링크와 제목(매체, 날짜)을 적습니다. 출처가 없는 내용은 받지 않습니다.'],
	['\'확인필요\'는 무슨 뜻인가요?', '아직 방송·행사 전이거나 근거가 하나뿐이라 확정하지 못했다는 표시입니다. 방송 후 기사나 공식 공지가 나오면 갱신해 주세요.'],
	['영상이나 사진을 올려도 되나요?', '파일을 올리지 않고 원본 게시물 링크만 연결합니다. 출연 영상은 방송사·채널의 공식 업로드만 받으며 팬 재업로드나 짜깁기는 받지 않습니다.'],
	['일정은 어떻게 추가하나요?', '출연 문서에 eventDate(YYYY-MM-DD)와 선택으로 eventTime(HH:MM)을 적으면 일정 페이지에 올라갑니다. 제보 양식에 날짜를 적어도 됩니다.'],
	['잘못된 내용이나 삭제를 요청하려면요?', '기업·소속사·권리자를 포함해 누구든 정정·삭제 요청을 남길 수 있습니다. 확인 후 최대한 빠르게 반영합니다.'],
];
---
<Base title="자주 묻는 질문" description="리센느 계열사의 용어, 기록 원칙, 편집·제보·삭제 요청 방법을 모았습니다.">
	<article class="prose">
		<h1>자주 묻는 질문</h1>
		{faqs.map(([q, a]) => (
			<details class="faq">
				<summary>{q}</summary>
				<p>{a}</p>
			</details>
		))}
		<p>
			<a href={newIssueUrl('correction.yml')}>정정·삭제 요청</a> · <a href={newIssueUrl('new-appearance.yml')}>출연 제보</a> · <a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>편집 가이드</a>
		</p>
	</article>
</Base>
