---
import '../styles/global.css';
import { url, REPO_URL, newIssueUrl } from '../config';
interface Props { title?: string; description?: string; image?: string }
const DEFAULT_DESC = '리센느와 함께한 기업과 기업이 공개한 이미지·영상을 팬들이 함께 기록하는 비공식 팬 위키';
const { title, description = DEFAULT_DESC, image } = Astro.props;
const updated = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Seoul' }).format(new Date());
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const full = title ? `${title} · 리센느 계열사` : '리센느 계열사 · 리센느와 함께한 기업 위키';
---
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600&family=Gowun+Batang:wght@400;700&display=swap" rel="stylesheet" />
		<link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
		<meta name="generator" content={Astro.generator} />
		<title>{full}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="리센느 계열사" />
		<meta property="og:title" content={full} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{image && <meta property="og:image" content={image} />}
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
	</head>
	<body>
		<header class="site">
			<div class="wrap">
				<a class="brand" href={url()}><b>리센느 계열사</b><small>for REMINE</small></a>
				<nav>
					<a href={url('about/')}>소개</a>
					<a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>편집 가이드</a>
					<a href={REPO_URL}>GitHub</a>
					<a class="cta" href={newIssueUrl('new-sponsor.yml')}>기업 제보</a>
				</nav>
			</div>
		</header>
		<main class="wrap"><slot /></main>
		<footer class="site">
			<div class="wrap">
				<span class="remine">Re : Scene, for REMINE</span>
				<nav class="foot-nav">
					<a href={url('about/')}>소개</a>
					<a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>편집 가이드</a>
					<a href={newIssueUrl('correction.yml')}>정정·삭제 요청</a>
					<a href={REPO_URL}>GitHub</a>
				</nav>
				팬이 만든 비공식 사이트이며 소속사·기업과 무관합니다.<br />
				사진·영상은 공식 채널과 원본 게시물에서 불러오며, 저작권은 각 권리자에게 있습니다.<br />
				마지막 배포 {updated}
			</div>
		</footer>
	</body>
</html>
